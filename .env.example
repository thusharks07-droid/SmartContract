# Browser-visible Supabase project configuration. These are public values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Public local API address. The development default is http://127.0.0.1:8765.
VITE_CONTRACTIQ_API_URL=http://127.0.0.1:8765
# Legacy fallback for projects that have not created a publishable key.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Never add a Supabase PAT, secret/service_role key, database password, or
# analyzer secret to a VITE_ variable. Those belong only in trusted servers.
