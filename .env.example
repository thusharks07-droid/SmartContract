# Browser-visible Supabase project configuration. These are public values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Local API address; override with the HTTPS API origin in production builds.
VITE_CONTRACTIQ_API_URL=http://127.0.0.1:8765
# Local unauthenticated scan service; keep this bound to localhost.
LOCAL_MODE=true
LOCAL_MODE_DB_PATH=.local-data/smartbob.sqlite3
# Legacy fallback for projects that have not created a publishable key.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Never add a Supabase PAT, secret/service_role key, database password, or
# analyzer secret to a VITE_ variable. Those belong only in trusted servers.
# Local backend-only settings are read by scanner-worker/server.py from this
# ignored root .env. The public URL/key above can be reused for backend Auth;
# the service-role key below is required only by the trusted backend.
CONTRACTIQ_SUPABASE_SERVICE_ROLE_KEY=
# Local backend-only provider secrets may be set here for development. The
# Python API reads these allowlisted non-VITE keys; deploy them in backend secrets.
GEMINI_API_KEY=
GROQ_API_KEY=
# smartBOB defaults to Groq first and Gemini only for transient availability failures.
SMARTBOB_AI_PRIMARY_PROVIDER=groq
SMARTBOB_AI_FALLBACK_PROVIDER=gemini
# Optional model overrides; defaults are reviewed in scanner-worker/README.md.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
