CONTRACTIQ_SUPABASE_URL=https://<project-ref>.supabase.co
CONTRACTIQ_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
CONTRACTIQ_SUPABASE_SERVICE_ROLE_KEY=<inject-from-provider-secret-store>
