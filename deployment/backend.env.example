CONTRACTIQ_SUPABASE_URL=https://<project-ref>.supabase.co
CONTRACTIQ_SUPABASE_ANON_KEY=<public-anon-or-publishable-key>
CONTRACTIQ_SUPABASE_SERVICE_ROLE_KEY=<inject-from-provider-secret-store>
CONTRACTIQ_ALLOWED_ORIGINS=https://<your-frontend-host>
CONTRACTIQ_API_BIND_HOST=127.0.0.1
CONTRACTIQ_API_PORT=8765
CONTRACTIQ_API_MAX_CONCURRENCY=16
GEMINI_API_KEY=<inject-from-provider-secret-store>
GROQ_API_KEY=<inject-from-provider-secret-store>
SMARTBOB_AI_PRIMARY_PROVIDER=groq
SMARTBOB_AI_FALLBACK_PROVIDER=gemini
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
SMARTBOB_AI_TIMEOUT_SECONDS=10
